# Copy to .env (next to compose.yml) and fill in. .env is git-ignored; never
# commit real tokens. Docker Compose reads .env on its own. When running
# test-harness directly, set these in your shell instead.

# --- Slack -------------------------------------------------------------------
# Set all three to post the report to Slack; with any missing, the results are
# saved to test_results/ instead. Leave off --local.

# Incoming webhook for the channel (the report message).
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your-webhook-path
# Bot token with the files:write scope (uploads the charts and result files).
# Invite the bot to the channel: /invite @your-app
SLACK_TOKEN=xoxb-your-bot-token
# The channel ID (from the channel's details, eg C0123ABCD), not its #name.
SLACK_CHANNEL=C0123ABCD

# --- Optional (Docker Compose) -----------------------------------------------
# HARNESS_ARGS=load local_acceptance
# QUERY_PARAMETERS={"timeout": 300}
# RADIATOR_USERNAME=translator
# RADIATOR_PASSWORD=radiator
# RADIATOR_TOKEN=local-dev-token
# RADIATOR_PORT=8000
# RADIATOR_EXCLUDED_ENVS=dev
