# Copy to .env (next to compose.yml) and fill in. .env is git-ignored; never
# commit real tokens. Docker Compose reads .env on its own. When running
# test-harness directly, set these in your shell instead.

# --- Slack -------------------------------------------------------------------
# Set all three to post the report to Slack; with any missing, the results are
# saved to test_results/ instead. Leave off --local.

# Incoming webhook for the channel (the report message).
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your-webhook-path
# Bot token with the files:write scope (uploads the charts and result files).
# Invite the bot to the channel: /invite @your-app
SLACK_TOKEN=xoxb-your-bot-token
# The channel ID (from the channel's details, eg C0123ABCD), not its #name.
SLACK_CHANNEL=C0123ABCD

# --- Optional: Zebrunner, alongside the new radiator --------------------------
# Set both to report each run to Zebrunner as well. SLACK_CHANNEL then gets
# Zebrunner's report (with its link), and the new radiator's goes to
# RADIATOR_SLACK_* below, if set.
# ZE_BASE_URL=https://zebrunner.example.org
# ZE_REFRESH_TOKEN=your-zebrunner-refresh-token

# --- Optional: a Slack channel of the new radiator's own ----------------------
# While Zebrunner is configured (ZE_*), SLACK_CHANNEL is Zebrunner's and gets
# only the report it always did. Set these to post the new Information
# Radiator's reports (its link, pass-rate headline and charts), the run cycle
# boards and the weekly digest to a channel of their own. Without Zebrunner,
# SLACK_CHANNEL is the radiator's and these aren't needed.
# An incoming webhook posts to one channel only, so this needs its own; the
# bot token defaults to SLACK_TOKEN (invite the bot to this channel too).
# RADIATOR_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/another-webhook-path
# RADIATOR_SLACK_CHANNEL=C0456EFGH
# RADIATOR_SLACK_TOKEN=xoxb-another-bot-token

# --- Optional (Docker Compose) -----------------------------------------------
# HARNESS_ENV=ci
# HARNESS_ARGS=load local_acceptance
# QUERY_PARAMETERS={"timeout": 300}
# RADIATOR_USERNAME=translator
# RADIATOR_PASSWORD=radiator
# RADIATOR_TOKEN=local-dev-token
# RADIATOR_PORT=8000
# RADIATOR_EXCLUDED_ENVS=dev
